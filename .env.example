# Required: either DATABASE_URL or the individual DB_* variables.
# DATABASE_URL=postgresql://postgres:root@localhost:5432/postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_NAME=postgres
DB_SCHEMA=public
DB_SSL=false

# Optional bootstrap credentials. Used only when the user table is empty.
DEFAULT_ADMIN_EMAIL=admin@simsanfrasermain.com
DEFAULT_ADMIN_PASSWORD=admin@123
PRIMARY_ADMIN_EMAIL=admin@simsanfrasermain.com
SESSION_DAYS=2

# Optional compatibility for browser clients hosted on another origin.
# CORS_DOMAINS=https://www.example.com,https://admin.example.com
CORS_DOMAINS=

# Canonical public origin used in invoice and quote email links.
# Legacy BACKEND_URI values ending in /api are also accepted.
PUBLIC_APP_URL=

# Optional persistent storage paths for uploaded images and generated PDFs.
# Defaults are public/uploads and public/invoices.
IMAGE_UPLOAD_PATH=
INVOICE_OUTPUT_PATH=

# Queries slower than this threshold are logged. Query values are never logged.
SLOW_QUERY_MS=500

# Optional email delivery. The app still works when these are unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
ADMIN_EMAIL=

# Legacy mail names are supported as fallbacks during migration.
# EMAIL_USER=
# EMAIL_PWD=
